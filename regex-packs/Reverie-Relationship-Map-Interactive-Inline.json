      "replace_string": "<!-- UI_START --><style data-reverie-surface=\"relationship-map\">\n.rrm{--bg:#0c0a10;--panel:#15111a;--panel2:#1b1621;--text:#fbf7fc;--muted:#aa9eaf;--pink:#ef6ca9;--pinkSoft:rgba(239,108,169,.16);--green:#75dfb3;--greenSoft:rgba(117,223,179,.15);--gold:#f4c96f;--goldSoft:rgba(244,201,111,.15);--red:#ff6c7d;--redSoft:rgba(255,108,125,.15);--blue:#78b9ff;--blueSoft:rgba(120,185,255,.15);box-sizing:border-box;width:min(100%,920px);margin:16px auto;color:var(--text);font-family:var(--lumiverse-font-family,Inter,system-ui,-apple-system,\"Segoe UI\",sans-serif)}\n.rrm,.rrm *{box-sizing:border-box}.rrm>input{position:absolute!important;inline-size:1px!important;block-size:1px!important;opacity:0!important;pointer-events:none!important}\n.rrm-shell{overflow:hidden;border:1px solid rgba(255,255,255,.11);border-radius:25px;background:linear-gradient(145deg,#17121b,#0b090e);box-shadow:0 22px 54px rgba(0,0,0,.42)}\n.rrm-top{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 18px;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(9,8,12,.7)}\n.rrm-brand{display:flex;align-items:center;gap:11px;min-width:0}.rrm-logo{display:grid;place-items:center;width:39px;aspect-ratio:1;border-radius:13px;background:linear-gradient(135deg,var(--pink),#8d62f3);box-shadow:0 10px 24px rgba(239,108,169,.23);font-size:12px;font-weight:950}\n.rrm-heading{min-width:0}.rrm-heading h3{overflow:hidden;margin:0;color:#fff;font-size:15px;line-height:1.15;text-overflow:ellipsis;white-space:nowrap}.rrm-heading p{overflow:hidden;margin:4px 0 0;color:var(--muted);font-size:9px;text-overflow:ellipsis;white-space:nowrap}\n.rrm-live{display:flex;align-items:center;gap:7px;flex:0 0 auto;padding:7px 9px;border:1px solid rgba(117,223,179,.2);border-radius:999px;background:var(--greenSoft);color:#baf3dc;font-size:8px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.rrm-live:before{content:\"\";width:6px;aspect-ratio:1;border-radius:99px;background:var(--green);box-shadow:0 0 0 4px rgba(117,223,179,.1)}\n.rrm-body{display:grid;grid-template-columns:minmax(0,1fr) 250px;min-height:520px}.rrm-map-wrap{overflow:auto;background:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px),radial-gradient(circle at 50% 48%,rgba(239,108,169,.07),transparent 42%);background-size:27px 27px,27px 27px,100% 100%}\n.rrm-map{position:relative;width:100%;min-width:600px;min-height:520px}.rrm-lines{position:absolute;inset:0;z-index:1;width:100%;height:100%;pointer-events:none}.rrm-line{fill:none;stroke-width:2.2;stroke-linecap:round}.rrm-line.trusted{stroke:var(--green)}.rrm-line.strained{stroke:var(--gold);stroke-dasharray:7 6}.rrm-line.danger{stroke:var(--red)}.rrm-line.hidden{stroke:#887b91;stroke-dasharray:2 8}\n.rrm-link-label{position:absolute;z-index:7;max-width:112px;overflow:hidden;padding:4px 7px;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:#0d0a11;color:#d8cedd;font-size:7px;font-weight:750;line-height:1.2;text-overflow:ellipsis;white-space:nowrap;box-shadow:0 4px 12px rgba(0,0,0,.55);backdrop-filter:blur(8px);pointer-events:none}.rrm-l12{left:23%;top:29%}.rrm-l13{right:22%;top:29%}.rrm-l14{right:21%;bottom:28%}.rrm-l15{left:23%;bottom:28%}.rrm-l34{right:7%;top:49%}\n.rrm-node{position:absolute;z-index:4;width:122px;padding:9px;border:1px solid rgba(255,255,255,.1);border-radius:17px;background:linear-gradient(145deg,rgba(30,24,36,.98),rgba(13,11,16,.98));box-shadow:0 14px 30px rgba(0,0,0,.34);cursor:pointer;transition:.18s ease}.rrm-node:hover{transform:translateY(-3px);border-color:var(--node);box-shadow:0 17px 35px rgba(0,0,0,.42),0 0 0 3px var(--soft)}\n.rrm-node-a{--node:var(--pink);--soft:var(--pinkSoft);left:50%;top:50%;width:136px;transform:translate(-50%,-50%)}.rrm-node-a:hover{transform:translate(-50%,calc(-50% - 3px))}.rrm-node-b{--node:var(--green);--soft:var(--greenSoft);left:2%;top:9%}.rrm-node-c{--node:var(--gold);--soft:var(--goldSoft);right:2%;top:9%}.rrm-node-d{--node:var(--red);--soft:var(--redSoft);right:2%;bottom:9%}.rrm-node-e{--node:var(--blue);--soft:var(--blueSoft);left:2%;bottom:9%}\n.rrm-photo{position:relative;display:grid;place-items:center;width:100%;aspect-ratio:1.2/1;overflow:hidden;border-radius:12px;background:linear-gradient(145deg,var(--soft),rgba(255,255,255,.025))}.rrm-photo:after{content:\"\";position:absolute;inset:0;background:linear-gradient(to top,rgba(5,4,7,.48),transparent 58%);pointer-events:none}.rrm-photo img,.rrm-photo image_request>img{display:block;width:100%;height:100%;object-fit:cover}.rrm-photo image_request{display:grid;width:100%;height:100%;place-items:center}.rrm-photo image_request:not(:has(img)):before{content:\"R³\";display:grid;place-items:center;width:44px;aspect-ratio:1;border:1px solid rgba(255,255,255,.15);border-radius:50%;background:var(--soft);color:var(--node);font-size:12px;font-weight:950}.rrm scene_brief{display:none!important}\n.rrm-node-name{display:block;overflow:hidden;margin-top:8px;color:#fff;font-size:11px;font-weight:900;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}.rrm-node-role{display:block;overflow:hidden;margin-top:3px;color:var(--muted);font-size:7.5px;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}.rrm-node-status{display:inline-flex;margin-top:6px;padding:3px 6px;border-radius:999px;background:var(--soft);color:var(--node);font-size:6.5px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}\n.rrm-side{padding:18px;border-left:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,rgba(22,18,27,.98),rgba(11,9,14,.98))}.rrm-kicker{color:var(--pink);font-size:7px;font-weight:950;letter-spacing:.15em;text-transform:uppercase}.rrm-detail{display:none}.rrm-detail-head{display:flex;align-items:center;gap:10px;margin-top:11px}.rrm-detail-icon{display:grid;place-items:center;width:43px;aspect-ratio:1;border-radius:14px;background:var(--pinkSoft);color:var(--pink);font-size:14px;font-weight:950}.rrm-detail h4{margin:0;color:#fff;font-size:16px;line-height:1.1}.rrm-detail-role{margin:4px 0 0;color:var(--muted);font-size:8px}.rrm-summary{margin:15px 0 0;color:#ddd4e1;font-size:10px;line-height:1.55}.rrm-card{margin-top:11px;padding:11px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.035)}.rrm-card-label{color:var(--muted);font-size:6.5px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.rrm-card-value{margin-top:6px;color:#f3edf5;font-size:9px;line-height:1.45}.rrm-meter{height:6px;margin-top:8px;overflow:hidden;border-radius:99px;background:rgba(255,255,255,.07)}.rrm-meter span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--pink),#9b73ff)}\n.rrm-unknown{margin-top:13px;border:1px solid rgba(142,121,161,.24);border-radius:14px;background:rgba(142,121,161,.07)}.rrm-unknown summary{padding:10px 11px;color:#d7cadf;font-size:8px;font-weight:850;cursor:pointer;list-style:none}.rrm-unknown summary::-webkit-details-marker{display:none}.rrm-unknown summary:after{content:\"＋\";float:right;color:var(--pink)}.rrm-unknown[open] summary:after{content:\"−\"}.rrm-unknown div{padding:0 11px 11px;color:var(--muted);font-size:8px;line-height:1.45}.rrm-insight{margin-top:13px;padding:11px;border:1px solid rgba(239,108,169,.2);border-radius:14px;background:linear-gradient(145deg,rgba(239,108,169,.1),rgba(239,108,169,.025));color:#d9cbd5;font-size:8px;line-height:1.45}.rrm-insight b{display:block;margin-bottom:5px;color:#ffd7e8;font-size:8px}\n#rrm-$1-a:checked~.rrm-shell .rrm-detail-a,#rrm-$1-b:checked~.rrm-shell .rrm-detail-b,#rrm-$1-c:checked~.rrm-shell .rrm-detail-c,#rrm-$1-d:checked~.rrm-shell .rrm-detail-d,#rrm-$1-e:checked~.rrm-shell .rrm-detail-e{display:block}\n#rrm-$1-a:checked~.rrm-shell .rrm-node-a,#rrm-$1-b:checked~.rrm-shell .rrm-node-b,#rrm-$1-c:checked~.rrm-shell .rrm-node-c,#rrm-$1-d:checked~.rrm-shell .rrm-node-d,#rrm-$1-e: